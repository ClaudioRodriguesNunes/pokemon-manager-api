generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Pokemon {
  id             String  @id @default(uuid())
  name           String
  type           String
  hp             Int
  attack         Int
  defense        Int
  spriteUrl      String?
  baseExperience Int?
  height         Int?
  weight         Int?

  @@map("pokemons")
}

model Trainer {
  id             String           @id @default(uuid())
  name           String
  nameNormalized String           @unique
  age            Int
  city           String
  email          String           @unique
  captures PokemonCapture[]

  @@map("trainers")
}

model PokemonCapture {
  id             String   @id @default(uuid())
  trainerId      String
  active         Boolean  @default(true)
  pokeApiId      Int
  name           String
  types          String[]
  hp             Int
  attack         Int
  defense        Int
  specialAttack  Int
  specialDefense Int
  speed          Int
  spriteUrl      String?
  baseExperience Int?
  height         Int?
  weight         Int?
  trainer        Trainer  @relation(fields: [trainerId], references: [id], onDelete: Restrict)

  @@index([trainerId, active])
  @@unique([trainerId, pokeApiId])
  @@map("captures")
}
