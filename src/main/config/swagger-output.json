{
  "openapi": "3.0.0",
  "info": {
    "version": "2.0.0",
    "title": "PokéManager API",
    "description": "Entrega 2 atualizada: Pokédex via PokéAPI, Treinadores, Capturas, time ativo e liberação."
  },
  "servers": [
    {
      "url": "http://localhost:3333",
      "description": "Servidor local da PokéManager API"
    }
  ],
  "tags": [
    {
      "name": "Pokédex",
      "description": "Consulta direta à PokéAPI oficial"
    },
    {
      "name": "Treinadores",
      "description": "Cadastro, Capturas, time ativo e liberação"
    }
  ],
  "paths": {
    "/api/v1/pokedex/search": {
      "get": {
        "tags": [
          "Pokédex"
        ],
        "summary": "Buscar Pokémon na PokéAPI oficial",
        "description": "Consulta por nome e devolve um DTO formatado. Requer acesso à internet; timeout ou resposta externa inválida resultam em 503.",
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "required": true,
            "example": "pikachu",
            "description": "Nome do Pokémon",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Pokémon encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/PokemonSnapshot"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Query inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Pokémon não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno inesperado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "PokéAPI indisponível, timeout ou resposta inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/trainers": {
      "get": {
        "tags": [
          "Treinadores"
        ],
        "summary": "Listar Treinadores",
        "description": "Lista todos os Treinadores em ordem estável por nome e UUID.",
        "responses": {
          "200": {
            "description": "Treinadores encontrados",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Trainer"
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Erro interno inesperado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Treinadores"
        ],
        "summary": "Cadastrar Treinador",
        "description": "",
        "responses": {
          "201": {
            "description": "Treinador persistido com UUID",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/Trainer"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Body inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Nome ou e-mail já cadastrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno inesperado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "age",
                  "city",
                  "email"
                ],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "Claudio"
                  },
                  "age": {
                    "type": "integer",
                    "example": 25,
                    "minimum": 1
                  },
                  "city": {
                    "type": "string",
                    "example": "São Paulo"
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "claudio@example.com"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/trainers/search": {
      "get": {
        "tags": [
          "Treinadores"
        ],
        "summary": "Pesquisar Treinadores por nome",
        "description": "Pesquisa por trecho do nome, ignorando maiúsculas/minúsculas e espaços externos. Homônimos são retornados juntos.",
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "required": true,
            "example": "misty",
            "description": "Nome ou trecho do nome do Treinador",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Treinadores encontrados; lista vazia quando não houver correspondência",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Trainer"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Query inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno inesperado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/trainers/by-name/{trainerName}/captures": {
      "post": {
        "tags": [
          "Treinadores"
        ],
        "summary": "Capturar Pokémon pelo nome do Treinador",
        "description": "Os nomes do Treinador e do Pokémon são aparados e comparados sem diferenciar maiúsculas/minúsculas. O snapshot completo da PokéAPI é persistido. Um Treinador pode ter no máximo seis Capturas ativas e não pode capturar o mesmo Pokémon duas vezes, mesmo após liberação.",
        "parameters": [
          {
            "name": "trainerName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "Claudio",
            "description": "Nome normalizado do Treinador; espaços podem ser codificados na URL"
          }
        ],
        "responses": {
          "201": {
            "description": "Snapshot ativo persistido",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/Capture"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Nome ou body inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Treinador ou Pokémon não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Nome duplicado, Pokémon já capturado ou limite de seis Capturas ativas atingido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno inesperado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "PokéAPI indisponível, timeout ou resposta inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name"
                ],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "pikachu"
                  }
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Treinadores"
        ],
        "summary": "Consultar histórico por nome",
        "description": "Retorna todas as Capturas do Treinador, incluindo as liberadas (active=false).",
        "parameters": [
          {
            "name": "trainerName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "Claudio",
            "description": "Nome normalizado do Treinador"
          }
        ],
        "responses": {
          "200": {
            "description": "Histórico completo de Capturas",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Capture"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Nome inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Treinador não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno inesperado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/trainers/by-name/{trainerName}/team": {
      "get": {
        "tags": [
          "Treinadores"
        ],
        "summary": "Consultar time por nome",
        "description": "Retorna somente Capturas ativas; Capturas liberadas continuam preservadas no histórico.",
        "parameters": [
          {
            "name": "trainerName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "Claudio",
            "description": "Nome normalizado do Treinador"
          }
        ],
        "responses": {
          "200": {
            "description": "Time ativo",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Capture"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Nome inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Treinador não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno inesperado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/trainers/by-name/{trainerName}/captures/by-name/{pokemonName}/release": {
      "patch": {
        "tags": [
          "Treinadores"
        ],
        "summary": "Liberar Captura pelo nome",
        "description": "Marca a Captura como inativa sem exclusão física. A operação é idempotente: repeti-la devolve 200 e o mesmo snapshot inativo.",
        "parameters": [
          {
            "name": "trainerName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "Claudio",
            "description": "Nome normalizado do Treinador"
          },
          {
            "name": "pokemonName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "pikachu",
            "description": "Nome normalizado do Pokémon"
          }
        ],
        "responses": {
          "200": {
            "description": "Captura preservada e inativa",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/Capture"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Nome ou body inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Treinador ou Captura não encontrada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno inesperado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "example": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PokemonSnapshot": {
        "type": "object",
        "properties": {
          "pokeApiId": {
            "type": "number",
            "example": 25
          },
          "name": {
            "type": "string",
            "example": "pikachu"
          },
          "types": {
            "type": "array",
            "example": [
              "electric"
            ],
            "items": {
              "type": "string"
            }
          },
          "stats": {
            "type": "object",
            "properties": {
              "hp": {
                "type": "number",
                "example": 35
              },
              "attack": {
                "type": "number",
                "example": 55
              },
              "defense": {
                "type": "number",
                "example": 40
              },
              "specialAttack": {
                "type": "number",
                "example": 50
              },
              "specialDefense": {
                "type": "number",
                "example": 50
              },
              "speed": {
                "type": "number",
                "example": 90
              }
            }
          },
          "spriteUrl": {
            "type": "string",
            "example": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/25.png"
          },
          "baseExperience": {
            "type": "number",
            "example": 112
          },
          "height": {
            "type": "number",
            "example": 4
          },
          "weight": {
            "type": "number",
            "example": 60
          }
        }
      },
      "Capture": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "123e4567-e89b-42d3-a456-426614174001"
          },
          "trainerId": {
            "type": "string",
            "example": "123e4567-e89b-42d3-a456-426614174000"
          },
          "active": {
            "type": "boolean",
            "example": true
          },
          "pokeApiId": {
            "type": "number",
            "example": 25
          },
          "name": {
            "type": "string",
            "example": "pikachu"
          },
          "types": {
            "type": "array",
            "example": [
              "electric"
            ],
            "items": {
              "type": "string"
            }
          },
          "stats": {
            "type": "object",
            "properties": {
              "hp": {
                "type": "number",
                "example": 35
              },
              "attack": {
                "type": "number",
                "example": 55
              },
              "defense": {
                "type": "number",
                "example": 40
              },
              "specialAttack": {
                "type": "number",
                "example": 50
              },
              "specialDefense": {
                "type": "number",
                "example": 50
              },
              "speed": {
                "type": "number",
                "example": 90
              }
            }
          },
          "spriteUrl": {
            "type": "string",
            "example": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/25.png"
          },
          "baseExperience": {
            "type": "number",
            "example": 112
          },
          "height": {
            "type": "number",
            "example": 4
          },
          "weight": {
            "type": "number",
            "example": 60
          }
        }
      },
      "Trainer": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "123e4567-e89b-42d3-a456-426614174000"
          },
          "name": {
            "type": "string",
            "example": "Misty"
          },
          "age": {
            "type": "number",
            "example": 16
          },
          "city": {
            "type": "string",
            "example": "Cerulean"
          },
          "email": {
            "type": "string",
            "example": "misty@example.com"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "error"
          },
          "message": {
            "type": "string",
            "example": "Dados de entrada inválidos."
          },
          "details": {
            "type": "array",
            "example": [],
            "items": {}
          }
        }
      }
    }
  }
}